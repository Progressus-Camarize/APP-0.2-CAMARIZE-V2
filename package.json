{
  "name": "app-0.2-camarize",
  "version": "1.0.0",
  "description": "CAMARIZE",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "install:all": "cd api && npm install && cd ../front-react && npm install",
    "dev:api": "cd api && npm start",
    "dev:front": "cd front-react && npm run dev",
    "dev:both": "concurrently \"npm run dev:api\" \"npm run dev:front\"",
    "test:api": "cd api && npm run test",
    "test:e2e": "playwright test",
    "lint": "npm --prefix api run lint && npm --prefix front-react run lint",
    "build:front": "cd front-react && npm run build",
    "check:secrets": "node scripts/ci/check-secrets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitor101/APP-0.2-CAMARIZE.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joaovitor101/APP-0.2-CAMARIZE/issues"
  },
  "homepage": "https://github.com/joaovitor101/APP-0.2-CAMARIZE#readme",
  "dependencies": {
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
